{
  "name": "auros-recipe",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "The recipe toolchain: validate a recipe.yaml, compile it to a Containerfile, explain it in English.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "bin": {
    "auros-recipe": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "tsc -p tsconfig.test.json && node --test test/*.test.ts"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.9.2"
  }
}
