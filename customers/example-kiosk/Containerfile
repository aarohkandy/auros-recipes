#   recipe            example-kiosk
#   base image        ghcr.io/aarohkandy/auros-base:hardened
#   base pinned by    tag only -- this recipe has never been built, so no digest was available
#   namespace from    auros.config.json (the one file that holds it)
#   SOURCE_DATE_EPOCH 1789603200 (midnight UTC on 2026-09-17, the recipe's approval date)
#   architecture      x86_64
#
# THE BASE IS NOT CHOSEN HERE. The default of ARG BASE below comes from auros.config.json, the
# one file that holds the namespace. Nothing in a recipe can influence it -- not a registry, not
# a tag, not a digest. Every fleet sits on the same foundation, and that is the only reason a
# security fix is one rebuild instead of a spreadsheet.
#
# THE ONE OVERRIDE, AND WHY IT EXISTS. `--build-arg BASE=...` swaps the foundation for one local
# build. It is not reachable from recipe.yaml -- the validator refuses a recipe that names a base
# at all -- so it cannot put one fleet on a different foundation from another. It exists for the
# single case the replaceability page documents: our registry is gone, you have built the base
# yourself from its public repository, and you need this file to point at your copy. Without it
# that instruction would be a command that cannot work, which is worse than no instruction.
#
# The digest pin is for this build only. When the base moves, propagation notices this recipe is
# stale and rebuilds it against the new digest. A pin that lived in the recipe would freeze this
# organisation off the rebuild that carries the next security fix.
#
# NO BUILD CONTEXT IS REQUIRED. Everything this file installs it carries inline. `podman build`
# against an empty directory produces the image. That is what makes "if we vanish, you rebuild
# your exact operating system from the file" something you can test rather than something we say.
#
# WHO THESE MACHINES ARE FOR, in the words of the person who ordered them:
#
#     Forty counter kiosks across six walk-in service centres. A visitor sits down, uses the
#     benefits and job-search sites, prints what they need, and walks away. Nobody signs in and
#     the session is wiped behind them.
#
# DISCLOSED AT VALIDATION TIME:
#   - hardware.models[0]: 'dell-optiplex-7010' has no row in hardware/compat.tsv yet. Allowed, and stamped on the build report and on the pull request as untested hardware, so it is a disclosed unknown rather than a skipped check.
#   - hardware.models[1]: 'hp-elitedesk-800-g1' has no row in hardware/compat.tsv yet. Allowed, and stamped on the build report and on the pull request as untested hardware, so it is a disclosed unknown rather than a skipped check.
#   - hardware.models[2]: 'lenovo-thinkcentre-m92p' has no row in hardware/compat.tsv yet. Allowed, and stamped on the build report and on the pull request as untested hardware, so it is a disclosed unknown rather than a skipped check.
#   - theme: recorded in the image as data. The desktop layer that reads it is not built yet, so the preset, accent, text scale and cursor size do not change how these machines look today. This is stamped on the build report rather than left for the customer to notice.
# =================================================================================================

ARG BASE=ghcr.io/aarohkandy/auros-base:hardened
FROM ${BASE}

ARG SOURCE_DATE_EPOCH=1789603200

# -euo pipefail for every RUN below rather than repeated at the top of each. A build step that
# fails quietly in the middle of a pipeline is how an image ships half-configured, and
# DECISIONS.md D19 is what that cost us the first time.
SHELL ["/usr/bin/bash", "-euo", "pipefail", "-c"]

# -------------------------------------------------------------------------------------------------
# EVERY HUMAN STRING IN THIS RECIPE, AS DATA.
#
# base64 is [A-Za-z0-9+/=]. No byte of what a customer wrote is ever a shell word, whatever
# they wrote, which is the whole reason this is one encoded blob rather than ten echo lines.
# Decode it to read it:  base64 -d <<< '<the string below>'
#
# HONEST GAP: branding.json also carries the theme block, and the desktop layer that reads it
# is not built yet. Today those fields reach the image as data and are applied by nothing.
# Validation says so on every recipe that sets a theme, so it is a disclosed gap rather than a
# field quietly doing nothing.
# -------------------------------------------------------------------------------------------------
RUN install -d -m 0755 /usr/share/auros/branding && \
    printf '%s' '' | base64 -d > /usr/share/auros/branding/branding.json && \
    chmod 0644 /usr/share/auros/branding/branding.json

RUN install -d -m 0755 /usr/share/auros && \
    printf '%s' '' | base64 -d > /usr/share/auros/prune-plan.json && \
    chmod 0644 /usr/share/auros/prune-plan.json

RUN install -d -m 0755 /usr/libexec/auros && \
    printf '%s' '' | base64 -d > /usr/libexec/auros/auros-prune && \
    chmod 0755 /usr/libexec/auros/auros-prune

RUN install -d -m 0755 /etc/auros && \
    printf '%s' '' | base64 -d > /etc/auros/kiosk.conf && \
    chmod 0644 /etc/auros/kiosk.conf

# -------------------------------------------------------------------------------------------------
# LANGUAGE, KEYBOARD AND CLOCK
#
#   language   English (United States) -> en_US.UTF-8
#   keyboard   English (US) -> us
#   timezone   America/Los_Angeles -- a name, not an offset. An offset is wrong twice a year.
# -------------------------------------------------------------------------------------------------
RUN printf 'LANG=%s\n' en_US.UTF-8 > /etc/locale.conf && \
    printf 'KEYMAP=%s\n' us > /etc/vconsole.conf && \
    install -d -m 0755 /etc/X11/xorg.conf.d && \
    printf '%s' 'IyBHZW5lcmF0ZWQgYnkgYXVyb3MtcmVjaXBlIGNvbXBpbGUuIERvIG5vdCBlZGl0IGluIHRoZSBpbWFnZS4KU2VjdGlvbiAiSW5wdXRDbGFzcyIKICAgIElkZW50aWZpZXIgImF1cm9zLWtleWJvYXJkIgogICAgTWF0Y2hJc0tleWJvYXJkICJvbiIKICAgIE9wdGlvbiAiWGtiTGF5b3V0IiAidXMiCkVuZFNlY3Rpb24K' | base64 -d > /etc/X11/xorg.conf.d/00-auros-keyboard.conf && \
    ln -snf ../usr/share/zoneinfo/America/Los_Angeles /etc/localtime

# -------------------------------------------------------------------------------------------------
# WHAT GOES ON: 1 applications, plus the fonts English (United States) needs.
#
# The fonts are not in the recipe. Choosing a language chooses them, so there is no font list
# for anybody to get wrong, and no first-boot screen of empty boxes.
# -------------------------------------------------------------------------------------------------
RUN dnf -y install \
        google-noto-sans-vf-fonts \
        google-noto-serif-vf-fonts && \
    dnf -y clean all

# Flathub applications are declared, not installed: flatpak-preinstall(1) materialises them on
# the machine. Spec section 3 -- userspace apps update themselves and are explicitly not our
# security surface. The image owns everything that can root the machine; Flatpaks own the rest.
RUN install -d -m 0755 /etc/flatpak/preinstall.d && \
    printf '[Flatpak Preinstall %s]\n' org.mozilla.firefox > /etc/flatpak/preinstall.d/org-mozilla-firefox.preinstall

# -------------------------------------------------------------------------------------------------
# POLICY: kiosk
#
# There is exactly one base image and four policy modes. The mode is chosen in this derived
# layer, which is the only place it can be chosen without turning four modes into four bases.
#
# kiosk removes the desktop shell and the display manager -- the binaries a person at the
# machine could reach a desktop through -- and a check on every build asserts they are absent
# from the filesystem. It does NOT mean everything else is gone: shared libraries the closure
# will not release stay, and this image is therefore meaningfully larger than a purpose-built
# minimal one. We trade that size for the property that a security fix is still one rebuild.
# See DECISIONS.md D12. The build reports the real measured size.
# -------------------------------------------------------------------------------------------------
RUN /usr/libexec/auros/apply-policy kiosk

# -------------------------------------------------------------------------------------------------
# THE PRUNE. This is the product.
#
#   57 packages named for removal, from "keep only the applications above"
#   the floor is 1100: a build that removes fewer FAILS
#   27 packages are kept whatever anybody asked, because the machine cannot start,
#   update or roll back without them
#
# auros-prune resolves the removal transaction before executing it and aborts if the closure
# would take a protected package with it, then removes, then verifies every protected package
# is still installed. That last step does not depend on parsing anybody's output format, which
# is why it is the one that counts.
# -------------------------------------------------------------------------------------------------
RUN /usr/libexec/auros/auros-prune

# -------------------------------------------------------------------------------------------------
# Labels last, so editing one does not invalidate the cache for every step above it.
# -------------------------------------------------------------------------------------------------
LABEL \
    auros.machines="40" \
    auros.policy="kiosk" \
    auros.prune.floor="1100" \
    auros.prune.named="57" \
    auros.recipe="example-kiosk" \
    auros.size-budget-gb="4" \
    auros.source-date-epoch="1789603200" \
    org.opencontainers.image.base.name="ghcr.io/aarohkandy/auros-base:hardened" \
    org.opencontainers.image.source="https://github.com/aarohkandy/auros-recipes" \
    org.opencontainers.image.title="ghcr.io/aarohkandy/auros-example-kiosk" \
    org.opencontainers.image.vendor="aarohkandy"

# -------------------------------------------------------------------------------------------------
# The structural check, run here as well as in CI. Here it fails the build at the point of damage;
# in CI it is the gate. It is deliberately not tolerated with `|| true` -- an image that cannot be
# a bootable host is worth nothing, and finding that out at build time beats finding it out in QEMU.
# -------------------------------------------------------------------------------------------------
RUN bootc container lint
